# 复制为 .env.local 后填入实际值（.env.local 已在 .gitignore 里，不会提交）

# ─── AI 推理 ───
# 说明：本副本已补齐 /api/interpret 与 /api/heming 两个后端接口，
# 排盘本身不需要 Key；只有「AI 解读」和「合盘 AI 分析」用到下面这组配置。
# Key 只在服务端读取，不会下发到浏览器。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# 可选服务商（改 AI_PROVIDER 即可，Key 填对应的项）
#   openai       → OPENAI_API_KEY
#   moonshot     → MOONSHOT_API_KEY
#   qwen         → DASHSCOPE_API_KEY
#   zhipu        → ZHIPU_API_KEY
#   siliconflow  → SILICONFLOW_API_KEY
#   anthropic    → ANTHROPIC_API_KEY（走 Anthropic 原生协议）
#   mimo         → MIMO_API_KEY（自定义网关，见下）

# ─── 自定义网关 / 覆盖默认模型 ───
# 任何 OpenAI 兼容服务都可以这样接（base url 末尾的 /v1 要保留）
# AI_BASE_URL=https://your-provider/v1
# AI_MODEL=model-name
# AI_API_KEY=your-api-key
#
# 或沿用原来的 MIMO_* 写法：
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
# 影响 sitemap.xml 与 canonical 链接；部署到线上时改成实际域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 静态导出（仅 npm run build:static 使用，一般不用改）───
# 部署到子路径时填前缀，例如 GitHub Pages 项目页填 /ziwei-doushu
# STATIC_BASE_PATH=/ziwei-doushu
